# 仅用于参考；正式环境通过 systemd 环境变量或受保护配置传递
# 注意：不要在公共仓库提交实际 .env / owner-token / device.json
RMCP_HOST=127.0.0.1
RMCP_PORT=8765
RMCP_PUBLIC_URL=https://gateway.example.com
RMCP_DB=/var/lib/remoteops/mcp.db
RMCP_CALL_TIMEOUT_MS=30000

# Google OpenID Connect 管理员登录（需要正式 HTTPS 域名）
# 在 Google Cloud Console 创建 Web application OAuth 客户端
# Authorized redirect URI: https://your-gateway-domain/admin/auth/google/callback
# 未配置下面三项则不显示 Google 登录入口
RMCP_GOOGLE_CLIENT_ID=
RMCP_GOOGLE_CLIENT_SECRET=
# 多个管理员邮箱使用英文逗号分隔，禁止通配符
RMCP_GOOGLE_ALLOWED_EMAILS=
