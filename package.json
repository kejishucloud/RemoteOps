{
  "name": "@kejishucloud/remoteops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kejishu RemoteOps - self-hosted multi-device MCP gateway and agents",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "remoteops-gateway": "gateway/server.js",
    "remoteops-agent": "agent/agent.js"
  },
  "scripts": {
    "gateway": "node gateway/server.js",
    "agent": "node agent/agent.js",
    "admin": "node gateway/admin.js",
    "test": "node --test test/*.test.js",
    "test:ci": "npm test",
    "check:secrets": "python3 scripts/secret_scan.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "google-auth-library": "^11.3.3",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kejishucloud/RemoteOps.git"
  }
}
